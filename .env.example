# OpenAI is optional. Without a key, the app uses local semantic ranking.
OPENAI_API_KEY=
OPENAI_CLIP_MODEL=gpt-5.6-luna
OPENAI_METADATA_MODEL=gpt-5.6-luna

# Docker services
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://shorts:shorts@postgres:5432/shorts

# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
